DATABASE_URL="postgresql://changemakers:changemakers@localhost:5432/changemakers"
JWT_SECRET="change-this-to-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:5173"
PORT=4000

# Public URL of the frontend, used to build password-reset links.
APP_URL="http://localhost:5173"

# Weeks run Monday 00:00 -> Sunday 23:59 in this timezone. Must match the frontend's
# VITE_APP_TIMEZONE, or the dashboard and the server will disagree about which week a
# Sunday-evening submission belongs to.
APP_TIMEZONE="America/Toronto"

# Email goes over HTTPS APIs, never raw SMTP (many hosts, including Render, silently drop
# outbound SMTP connections, which makes emails vanish with no error). Leave all of these unset
# in local development and reset/welcome emails are printed to the server console instead.
#
# Preferred: Gmail API, sending as a real Gmail account (no domain needed). Create a "Desktop
# app" OAuth client in Google Cloud with the Gmail API enabled, then run
# `node scripts/gmail-auth.js` to get the refresh token. MAIL_FROM must be that Gmail address.
# GMAIL_CLIENT_ID="..."
# GMAIL_CLIENT_SECRET="..."
# GMAIL_REFRESH_TOKEN="..."
# MAIL_FROM="WIRC Changemakers <westernislamicrelief@gmail.com>"
#
# Fallback: Resend. Its shared "onboarding@resend.dev" sender only delivers to the Resend
# account owner - verify your own domain at resend.com/domains to email anyone else.
# RESEND_API_KEY="re_your_api_key"
