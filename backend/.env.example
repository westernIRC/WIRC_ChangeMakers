DATABASE_URL="postgresql://changemakers:changemakers@localhost:5432/changemakers"
JWT_SECRET="change-this-to-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:5173"
PORT=4000

# Public URL of the frontend, used to build password-reset links.
APP_URL="http://localhost:5173"

# Weeks run Monday 00:00 -> Sunday 23:59 in this timezone. Must match the frontend's
# VITE_APP_TIMEZONE, or the dashboard and the server will disagree about which week a
# Sunday-evening submission belongs to.
APP_TIMEZONE="America/Toronto"

# Email via Resend's HTTPS API (not raw SMTP - many hosts, including Render, silently drop
# outbound SMTP connections, which makes emails vanish with no error). Leave RESEND_API_KEY
# unset in local development and reset/welcome emails are printed to the server console
# instead. Get a free API key at resend.com/api-keys; the shared "onboarding@resend.dev"
# sender works without owning a domain, or verify your own domain for a branded From address.
# RESEND_API_KEY="re_your_api_key"
# MAIL_FROM="WIRC Changemakers <onboarding@resend.dev>"
