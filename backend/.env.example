DATABASE_URL="postgresql://changemakers:changemakers@localhost:5432/changemakers"
JWT_SECRET="change-this-to-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:5173"
PORT=4000

# Public URL of the frontend, used to build password-reset links.
APP_URL="http://localhost:5173"

# Weeks run Monday 00:00 -> Sunday 23:59 in this timezone. Must match the frontend's
# VITE_APP_TIMEZONE, or the dashboard and the server will disagree about which week a
# Sunday-evening submission belongs to.
APP_TIMEZONE="America/Toronto"

# SMTP for password reset emails. Works with any provider (Resend, SendGrid, Mailgun,
# Postmark, Gmail app password, self-hosted). Leave SMTP_HOST unset in local development
# and reset links are printed to the server console instead of being emailed.
#
# Gmail (no domain required; needs 2-Step Verification, then an app password from
# myaccount.google.com/apppasswords with the spaces stripped). SMTP_USER and the address
# inside MAIL_FROM must be identical, or Gmail rewrites the From header. Limit 500/day.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="yourclub@gmail.com"
# SMTP_PASS="your16charapppassword"
# MAIL_FROM="WIRC Changemakers <yourclub@gmail.com>"
#
# Resend (requires a domain you actually own, verified via DNS in their dashboard).
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=587
# SMTP_USER="resend"
# SMTP_PASS="re_your_api_key"
# MAIL_FROM="WIRC Changemakers <no-reply@yourdomain.ca>"
